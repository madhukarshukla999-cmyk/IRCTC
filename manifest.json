{
  "manifest_version": 3,
  "name": "IRCTC Tatkal Autofill",
  "version": "2.1.2",
  "description": "Autofills IRCTC journey, login and passenger details, with a timed start for Tatkal. You type captchas and approve payment.",
  "permissions": [
    "storage",
    "scripting"
  ],
  "host_permissions": [
    "https://www.irctc.co.in/*",
    "https://www.irctcipay.com/*",
    "https://*.irctcipay.com/*"
  ],
  "action": {
    "default_popup": "popup.html",
    "default_title": "IRCTC Tatkal Autofill"
  },
  "content_scripts": [
    {
      "matches": [
        "https://www.irctc.co.in/*",
        "https://www.irctcipay.com/*",
        "https://*.irctcipay.com/*"
      ],
      "js": [
        "content.js"
      ],
      "run_at": "document_idle"
    }
  ],
  "background": {
    "service_worker": "background.js"
  }
}
