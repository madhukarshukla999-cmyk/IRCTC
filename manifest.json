{
  "manifest_version": 3,
  "name": "IRCTC Tatkal Autofill",
  "version": "1.3.0",
  "description": "Autofills IRCTC journey and passenger details from saved settings, with a timed start for Tatkal. You log in, solve captcha and pay.",
  "permissions": [
    "storage",
    "scripting"
  ],
  "host_permissions": [
    "https://www.irctc.co.in/*",
    "https://www.irctcipay.com/*",
    "https://*.irctcipay.com/*"
  ],
  "action": {
    "default_popup": "popup.html",
    "default_title": "IRCTC Tatkal Autofill"
  },
  "content_scripts": [
    {
      "matches": [
        "https://www.irctc.co.in/*",
        "https://www.irctcipay.com/*",
        "https://*.irctcipay.com/*"
      ],
      "js": [
        "content.js"
      ],
      "run_at": "document_idle"
    }
  ]
}
